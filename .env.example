# Database - For demo purposes, you can use a free PostgreSQL from ElephantSQL or Supabase
DATABASE_URL="postgresql://username:password@localhost:5432/lifetrack_db"

# NextAuth.js - Generate a secret at: https://generate-secret.vercel.app/32
NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="your-super-secret-key-here"

# OpenAI (optional for demo - the app will work with fallbacks)
OPENAI_API_KEY="sk-your-openai-key-here"

# Email (optional)
RESEND_API_KEY="re_your-api-key"
RESEND_FROM_EMAIL="noreply@your-domain.com"

# Push Notifications (optional)
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_EMAIL="your-email@example.com"