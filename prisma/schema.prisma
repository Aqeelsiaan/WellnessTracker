// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  healthData    HealthData[]
  emergencyInfo EmergencyInfo?
  wellnessGoals WellnessGoal[]
  achievements  UserAchievement[]
  notifications NotificationSettings[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model HealthData {
  id           String      @id @default(cuid())
  userId       String
  date         DateTime
  metricType   MetricType
  value        Json        // Stores different metric data
  notes        String?
  createdAt    DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, metricType, date])
  @@map("health_data")
}

model EmergencyInfo {
  id               String   @id @default(cuid())
  userId           String   @unique
  emergencyContact Json     // { name, phone, relationship }
  bloodType        String?
  allergies        String[]
  conditions       String[]
  medications      Json[]   // [{ name, dosage, frequency }]
  insurance        Json?    // { provider, policy number }
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("emergency_info")
}

model WellnessGoal {
  id                    String   @id @default(cuid())
  userId                String
  height                Float    // cm
  weight                Float    // kg
  age                   Int
  activityLevel         String   // enum: sedentary, light, moderate, active, very_active
  goalType              String   // enum: lose, gain, maintain
  targetWeight          Float?
  dietaryRestrictions   String[] // array of restrictions
  allergies             String[]
  preferences           String[]
  dailyCalorieGoal      Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wellness_goals")
}

model Achievement {
  id          String @id @default(cuid())
  name        String
  description String
  icon        String
  category    String // consistency, goals, improvement, milestones
  rarity      String // common, rare, epic, legendary

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  progress      Float    @default(0) // 0-1 for progress tracking

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model NotificationSettings {
  id                String   @id @default(cuid())
  userId            String
  type              String   // reading_reminder, medication_reminder, hydration_reminder
  enabled           Boolean  @default(true)
  time              String?  // for scheduled notifications
  data              Json?    // additional notification data
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_settings")
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String   // user, assistant
  content   String
  category  String?  // general, diet, exercise, mental, emergency
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("chat_messages")
}

enum MetricType {
  BLOOD_PRESSURE
  BLOOD_GLUCOSE
  WEIGHT
  WATER_INTAKE
  SLEEP
  EXERCISE
  STRESS
}